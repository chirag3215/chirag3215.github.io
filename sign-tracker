<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Street Sign Tracker</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/react/18.2.0/umd/react.production.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/react-dom/18.2.0/umd/react-dom.production.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/babel-standalone/7.23.2/babel.min.js"></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
    body { background: #2c2c3a; color: #fff; font-family: 'Courier New', monospace; overscroll-behavior: none; }
    ::-webkit-scrollbar { display: none; }
    input::placeholder { color: #555; }
    button:active { opacity: 0.85; }
  </style>
</head>
<body>
  <div id="root"></div>
  <script type="text/babel">
    const { useState, useMemo } = React;

    const SIGNS = [
      { id: 1, name: "Crosswalk", emoji: "🚶", category: "Road Infrastructure" },
      { id: 2, name: "Traffic Light", emoji: "🚦", category: "Road Infrastructure" },
      { id: 3, name: "Stop Sign", emoji: "🛑", category: "Road Infrastructure" },
      { id: 4, name: "Pedestrian Zone Sign", emoji: "🚷", category: "Road Infrastructure" },
      { id: 5, name: "Pedestrian Zone Ends Sign", emoji: "🔚", category: "Road Infrastructure" },
      { id: 6, name: "No Pedestrian Sign", emoji: "🚫", category: "Road Infrastructure" },
      { id: 7, name: "Pedestrian Crossing Sign", emoji: "🦺", category: "Road Infrastructure" },
      { id: 8, name: "Construction Sign", emoji: "🚧", category: "Road Infrastructure" },
      { id: 9, name: "Railroad Crossing Sign", emoji: "🚂", category: "Road Infrastructure" },
      { id: 10, name: "Street Name Sign", emoji: "🪧", category: "Road Infrastructure" },
      { id: 11, name: "Trailhead Sign", emoji: "🥾", category: "Road Infrastructure" },
      { id: 12, name: "Building Entrance", emoji: "🏢", category: "Maps Outdoor" },
      { id: 13, name: "Parking Meters", emoji: "⏱️", category: "Maps Outdoor" },
      { id: 14, name: "Large Parking Signs (garage)", emoji: "🅿️", category: "Navigation (OCR)" },
      { id: 15, name: "Restroom / Toilet", emoji: "🚻", category: "Public Information" },
      { id: 16, name: "Elevator", emoji: "🛗", category: "Public Information" },
      { id: 17, name: "Escalator", emoji: "🔼", category: "Public Information" },
      { id: 18, name: "Stairs", emoji: "🪜", category: "Public Information" },
      { id: 19, name: "Universal Changing Place", emoji: "♿", category: "Public Information" },
      { id: 20, name: "Library", emoji: "📚", category: "Public Information" },
      { id: 21, name: "Parking (sign)", emoji: "🅿️", category: "Public Information" },
      { id: 22, name: "EV Charger", emoji: "⚡", category: "Public Information" },
      { id: 23, name: "ATM", emoji: "💳", category: "Public Information" },
      { id: 24, name: "Picnic Area", emoji: "🧺", category: "Public Information" },
      { id: 25, name: "Play Area", emoji: "🛝", category: "Public Information" },
      { id: 26, name: "Hiking Trail", emoji: "🥾", category: "Public Information" },
      { id: 27, name: "Safety Symbols", emoji: "⚠️", category: "Safety & Navigation" },
      { id: 28, name: "Traffic Signs (general)", emoji: "🚗", category: "Safety & Navigation" },
      { id: 29, name: "Turn Restrictions", emoji: "↩️", category: "Road Sign" },
      { id: 30, name: "End Restrictions", emoji: "🔛", category: "Road Sign" },
      { id: 31, name: "Cycling", emoji: "🚴", category: "Road Sign" },
      { id: 32, name: "No Cycling", emoji: "🚳", category: "Road Sign" },
      { id: 33, name: "One Way (left)", emoji: "⬅️", category: "Road Sign" },
      { id: 34, name: "One Way (right)", emoji: "➡️", category: "Road Sign" },
      { id: 35, name: "School Zone", emoji: "🏫", category: "Road Sign" },
      { id: 36, name: "Do Not Enter", emoji: "⛔", category: "Road Sign" },
      { id: 37, name: "Parking Area", emoji: "🅿️", category: "Road Sign" },
      { id: 38, name: "Trash Cans", emoji: "🗑️", category: "Home & Appliances" },
      { id: 39, name: "Statue", emoji: "🗿", category: "Landmark" },
      { id: 40, name: "Fountain", emoji: "⛲", category: "Landmark" },
    ];

    const CATEGORIES = [...new Set(SIGNS.map(s => s.category))];

    const CATEGORY_COLORS = {
      "Road Infrastructure": "#f97316",
      "Maps Outdoor": "#3b82f6",
      "Navigation (OCR)": "#8b5cf6",
      "Public Information": "#10b981",
      "Safety & Navigation": "#ef4444",
      "Road Sign": "#f59e0b",
      "Home & Appliances": "#6366f1",
      "Landmark": "#ec4899",
    };

    function SignTracker() {
      const [counts, setCounts] = useState({});
      const [activeCategory, setActiveCategory] = useState("All");
      const [search, setSearch] = useState("");
      const [showSummary, setShowSummary] = useState(false);
      const [lastTapped, setLastTapped] = useState(null);

      const increment = (id) => {
        setCounts(prev => ({ ...prev, [id]: (prev[id] || 0) + 1 }));
        setLastTapped(id);
        setTimeout(() => setLastTapped(null), 300);
      };

      const decrement = (id) => {
        setCounts(prev => ({ ...prev, [id]: Math.max(0, (prev[id] || 0) - 1) }));
      };

      const reset = () => { setCounts({}); setShowSummary(false); };

      const totalSeen = useMemo(() => Object.values(counts).reduce((a, b) => a + b, 0), [counts]);
      const uniqueSeen = useMemo(() => Object.values(counts).filter(v => v > 0).length, [counts]);

      const filteredSigns = useMemo(() => SIGNS.filter(s => {
        const matchCat = activeCategory === "All" || s.category === activeCategory;
        const matchSearch = s.name.toLowerCase().includes(search.toLowerCase());
        return matchCat && matchSearch;
      }), [activeCategory, search]);

      const summaryData = useMemo(() =>
        SIGNS.filter(s => (counts[s.id] || 0) > 0)
          .sort((a, b) => (counts[b.id] || 0) - (counts[a.id] || 0)),
        [counts]);

      return (
        <div style={{ minHeight: "100vh", background: "#2c2c3a", color: "#fff", fontFamily: "'Courier New', monospace", paddingBottom: "100px" }}>
          {/* Header */}
          <div style={{ position: "sticky", top: 0, zIndex: 50, background: "rgba(44,44,58,0.97)", backdropFilter: "blur(12px)", borderBottom: "1px solid #333", padding: "14px 16px 10px" }}>
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start" }}>
              <div>
                <div style={{ fontSize: "11px", letterSpacing: "0.2em", color: "#9995aa", textTransform: "uppercase" }}>Walk Tracker</div>
                <div style={{ fontSize: "22px", fontWeight: "bold", letterSpacing: "-0.5px", lineHeight: 1.1 }}>Street Signs</div>
              </div>
              <div style={{ textAlign: "right" }}>
                <div style={{ fontSize: "28px", fontWeight: "bold", color: "#f97316", lineHeight: 1 }}>{totalSeen}</div>
                <div style={{ fontSize: "10px", color: "#9995aa", letterSpacing: "0.1em" }}>TOTAL TAPS</div>
                <div style={{ fontSize: "11px", color: "#c0bdd0", marginTop: "2px" }}>{uniqueSeen} types seen</div>
              </div>
            </div>
            <input
              type="text"
              placeholder="Search signs..."
              value={search}
              onChange={e => setSearch(e.target.value)}
              style={{ width: "100%", marginTop: "10px", background: "#32324a", border: "1px solid #333", borderRadius: "8px", padding: "8px 12px", color: "#fff", fontSize: "13px", fontFamily: "inherit", outline: "none" }}
            />
            <div style={{ display: "flex", gap: "6px", overflowX: "auto", marginTop: "10px", paddingBottom: "2px", scrollbarWidth: "none" }}>
              {["All", ...CATEGORIES].map(cat => (
                <button key={cat} onClick={() => setActiveCategory(cat)} style={{
                  flexShrink: 0, padding: "4px 10px", borderRadius: "20px", border: "1px solid",
                  fontSize: "10px", letterSpacing: "0.05em", cursor: "pointer", fontFamily: "inherit",
                  background: activeCategory === cat ? (cat === "All" ? "#fff" : CATEGORY_COLORS[cat]) : "transparent",
                  borderColor: activeCategory === cat ? (cat === "All" ? "#fff" : CATEGORY_COLORS[cat]) : "#333",
                  color: activeCategory === cat ? "#0f0f13" : "#888",
                }}>{cat}</button>
              ))}
            </div>
          </div>

          {/* Sign List */}
          <div style={{ padding: "12px 16px", display: "flex", flexDirection: "column", gap: "8px" }}>
            {filteredSigns.map(sign => {
              const count = counts[sign.id] || 0;
              const isActive = count > 0;
              const justTapped = lastTapped === sign.id;
              const color = CATEGORY_COLORS[sign.category];
              return (
                <div key={sign.id} style={{
                  display: "flex", alignItems: "center",
                  background: isActive ? `${color}12` : "#2e2e3e",
                  border: `1px solid ${isActive ? color + "40" : "#2e2e3e"}`,
                  borderRadius: "12px", overflow: "hidden",
                  transform: justTapped ? "scale(0.98)" : "scale(1)", transition: "all 0.15s",
                }}>
                  <button onClick={() => increment(sign.id)} style={{
                    flex: 1, display: "flex", alignItems: "center", gap: "12px", padding: "14px",
                    background: "transparent", border: "none", cursor: "pointer", textAlign: "left", color: "inherit", fontFamily: "inherit",
                  }}>
                    <span style={{ fontSize: "24px", lineHeight: 1 }}>{sign.emoji}</span>
                    <div>
                      <div style={{ fontSize: "13px", fontWeight: isActive ? "bold" : "normal", color: isActive ? "#fff" : "#aaa", lineHeight: 1.2 }}>{sign.name}</div>
                      <div style={{ fontSize: "10px", letterSpacing: "0.1em", textTransform: "uppercase", fontWeight: "700", color: isActive ? color : "#9985cc", marginTop: "2px" }}>{sign.category}</div>
                    </div>
                  </button>
                  <div style={{ display: "flex", alignItems: "center", paddingRight: "8px" }}>
                    {isActive && (
                      <button onClick={() => decrement(sign.id)} style={{
                        width: "32px", height: "32px", borderRadius: "50%", border: `1px solid ${color}50`,
                        background: "transparent", color: color, fontSize: "18px", cursor: "pointer",
                        display: "flex", alignItems: "center", justifyContent: "center", fontFamily: "inherit",
                      }}>−</button>
                    )}
                    <div style={{ width: "40px", textAlign: "center", fontSize: isActive ? "22px" : "16px", fontWeight: "bold", color: isActive ? color : "#333", transition: "all 0.15s" }}>
                      {count === 0 ? "·" : count}
                    </div>
                    <button onClick={() => increment(sign.id)} style={{
                      width: "32px", height: "32px", borderRadius: "50%", border: `1px solid ${color}80`,
                      background: isActive ? color + "20" : "transparent", color: isActive ? color : "#555",
                      fontSize: "18px", cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center", fontFamily: "inherit",
                    }}>+</button>
                  </div>
                </div>
              );
            })}
          </div>

          {/* Footer */}
          <div style={{ position: "fixed", bottom: 0, left: 0, right: 0, background: "rgba(44,44,58,0.97)", backdropFilter: "blur(12px)", borderTop: "1px solid #333", padding: "12px 16px", display: "flex", gap: "10px" }}>
            <button onClick={() => setShowSummary(true)} disabled={totalSeen === 0} style={{
              flex: 1, padding: "13px", borderRadius: "10px", border: "none",
              background: totalSeen > 0 ? "#f97316" : "#1a1a22", color: totalSeen > 0 ? "#fff" : "#444",
              fontSize: "13px", fontWeight: "bold", letterSpacing: "0.05em",
              cursor: totalSeen > 0 ? "pointer" : "default", fontFamily: "inherit",
            }}>View Summary ({uniqueSeen} types)</button>
            <button onClick={reset} style={{
              padding: "13px 18px", borderRadius: "10px", border: "1px solid #333",
              background: "transparent", color: "#9995aa", fontSize: "13px", cursor: "pointer", fontFamily: "inherit",
            }}>Reset</button>
          </div>

          {/* Summary Modal */}
          {showSummary && (
            <div onClick={() => setShowSummary(false)} style={{ position: "fixed", inset: 0, background: "rgba(0,0,0,0.8)", zIndex: 100, display: "flex", alignItems: "flex-end" }}>
              <div onClick={e => e.stopPropagation()} style={{
                width: "100%", background: "#2c2c3e", borderRadius: "20px 20px 0 0",
                border: "1px solid #333", padding: "20px 16px 40px", maxHeight: "80vh", overflowY: "auto",
              }}>
                <div style={{ textAlign: "center", marginBottom: "20px" }}>
                  <div style={{ fontSize: "11px", letterSpacing: "0.2em", color: "#9995aa", textTransform: "uppercase" }}>Walk Summary</div>
                  <div style={{ fontSize: "32px", fontWeight: "bold", color: "#f97316" }}>{totalSeen} signs</div>
                  <div style={{ fontSize: "13px", color: "#9995aa" }}>across {uniqueSeen} different types</div>
                </div>
                <div style={{ display: "flex", flexDirection: "column", gap: "8px" }}>
                  {summaryData.map(sign => {
                    const count = counts[sign.id];
                    const color = CATEGORY_COLORS[sign.category];
                    const pct = Math.round((count / totalSeen) * 100);
                    return (
                      <div key={sign.id} style={{ background: "#32324a", borderRadius: "10px", padding: "12px 14px", position: "relative", overflow: "hidden" }}>
                        <div style={{ position: "absolute", left: 0, top: 0, bottom: 0, width: `${pct}%`, background: color + "18" }} />
                        <div style={{ position: "relative", display: "flex", justifyContent: "space-between", alignItems: "center" }}>
                          <div style={{ display: "flex", alignItems: "center", gap: "10px" }}>
                            <span style={{ fontSize: "20px" }}>{sign.emoji}</span>
                            <div>
                              <div style={{ fontSize: "13px", fontWeight: "bold" }}>{sign.name}</div>
                              <div style={{ fontSize: "10px", color, letterSpacing: "0.1em", textTransform: "uppercase", fontWeight: "700" }}>{sign.category}</div>
                            </div>
                          </div>
                          <div style={{ textAlign: "right" }}>
                            <div style={{ fontSize: "22px", fontWeight: "bold", color }}>{count}</div>
                            <div style={{ fontSize: "10px", color: "#555" }}>{pct}%</div>
                          </div>
                        </div>
                      </div>
                    );
                  })}
                </div>
                <button onClick={() => setShowSummary(false)} style={{
                  width: "100%", marginTop: "16px", padding: "14px", borderRadius: "10px",
                  border: "1px solid #333", background: "transparent", color: "#b0adc0", fontSize: "13px", cursor: "pointer", fontFamily: "inherit",
                }}>Close</button>
              </div>
            </div>
          )}
        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById("root")).render(<SignTracker />);
  </script>
</body>
</html>
